{
  "name": "app-starter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "npm run test:build && npm run test:integration && npm run test:probes",
    "test:workers": "vitest run",
    "type-check": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json && tsc --noEmit && tsc -p probes/budget-protocol/tsconfig.client.json",
    "probe:build": "vite build --config probes/budget-protocol/vite.config.ts",
    "probe:deployment": "node probes/run.mjs deployment",
    "probe:budget-protocol": "node probes/run.mjs budget-protocol",
    "probe:recovery": "node probes/run.mjs recovery",
    "test:gate": "node --test tests/gates/verify-gate.test.mjs",
    "verify:gate": "node scripts/verify-gate.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:dev": "node scripts/deploy.mjs dev",
    "deploy:prod": "node scripts/deploy.mjs prod",
    "test:build": "node --test tests/build/*.test.mjs",
    "test:integration": "vitest run --config vitest.app.config.ts",
    "test:e2e": "playwright test",
    "test:probes": "npm run test:gate && node --test tests/probes/*.test.mjs && vitest run",
    "bootstrap:token": "node scripts/bootstrap-token.mjs",
    "auth:local:start": "node scripts/local-auth.mjs start",
    "auth:local:stop": "node scripts/local-auth.mjs stop",
    "test:e2e:public": "node scripts/public-e2e.mjs",
    "format": "prettier --write app.config.ts src scripts/{bootstrap-token,boundaries,config,deploy,deployment,dev,e2e-server,local-auth,process,public-e2e}.mjs tests/{build,integration,e2e} vite.config.ts vitest.app.config.ts playwright.config.ts locales wrangler.jsonc"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.2",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-label": "2.1.17",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.104.3",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "i18next": "26.4.7",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-i18next": "17.0.20",
    "react-router": "8.4.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/react": "4.0.147",
    "@assistant-ui/ai-sdk": "0.0.13",
    "@assistant-ui/react": "0.15.29",
    "@babel/parser": "8.0.7",
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "5.20261016.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ai": "7.0.143",
    "better-auth": "1.7.10",
    "jsonc-parser": "3.2.0",
    "prettier": "3.9.10",
    "stripe": "23.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "workers-ai-provider": "4.0.0",
    "wrangler": "4.151.1"
  }
}
