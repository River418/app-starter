{
  "name": "cloudflare-app-starter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "npm run test:gate && node --test tests/probes/*.test.mjs && vitest run",
    "test:workers": "vitest run",
    "type-check": "tsc --noEmit",
    "test:gate": "node --test tests/gates/verify-gate.test.mjs",
    "verify:gate": "node scripts/verify-gate.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.10",
    "hono": "4.13.13",
    "stripe": "23.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "5.20261016.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  }
}
