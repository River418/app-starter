{
  "name": "cloudflare-app-starter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "npm run test:gate && node --test tests/probes/*.test.mjs && vitest run",
    "test:workers": "vitest run",
    "type-check": "tsc --noEmit && tsc -p probes/budget-protocol/tsconfig.client.json",
    "probe:build": "vite build --config probes/budget-protocol/vite.config.ts",
    "probe:deployment": "node probes/run.mjs deployment",
    "probe:budget-protocol": "node probes/run.mjs budget-protocol",
    "probe:recovery": "node probes/run.mjs recovery",
    "test:gate": "node --test tests/gates/verify-gate.test.mjs",
    "verify:gate": "node scripts/verify-gate.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.147",
    "@assistant-ui/ai-sdk": "0.0.13",
    "@assistant-ui/react": "0.15.29",
    "ai": "7.0.143",
    "better-auth": "1.7.10",
    "hono": "4.13.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "23.0.0",
    "workers-ai-provider": "4.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "5.20261016.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  }
}
