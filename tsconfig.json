{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types", "node"]
  },
  "include": ["probes/**/*.ts", "vitest.config.ts"]
}
