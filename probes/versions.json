  },
  "dependencies": {
    "hono": "4.13.13",
    "better-auth": "1.7.10",
    "stripe": "23.0.0",
    "zod": "4.6.7",
    "ai": "7.0.143",
    "@ai-sdk/react": "4.0.147",
    "@ai-sdk/provider": "4.0.29",
    "workers-ai-provider": "4.0.0",
    "@assistant-ui/react": "0.15.29",
    "@assistant-ui/ai-sdk": "0.0.13",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "testing": {
    "vitest": "5.0.5",
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "5.20261016.1",
    "vite": "8.3.4",
    "@vitejs/plugin-react": "6.1.2",
