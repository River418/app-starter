{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cfas-probe-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_request_signal",
    "request_signal_passthrough"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "PROBE_ENV": "local",
    "PROBE_TITLE": "Validation probe",
    "BETTER_AUTH_URL": "http://probe.local"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cfas-probe-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "cfas-probe-local"
    }
  ],
  "workflows": [
    {
      "binding": "BOOTSTRAP_WORKFLOW",
      "name": "cfas-probe-local-bootstrap",
      "class_name": "BootstrapProbeWorkflow"
    },
    {
      "binding": "RUN_WORKFLOW",
      "name": "cfas-probe-local-recovery",
      "class_name": "RecoveryProbeWorkflow"
    },
    {
      "binding": "MODEL_WORKFLOW",
      "name": "cfas-probe-local-model",
      "class_name": "ModelProbeWorkflow"
    }
  ],
  "env": {
    "dev": {
      "name": "cfas-probe-418-20261017-dev",
      "vars": {
        "PROBE_ENV": "dev",
        "PROBE_TITLE": "Validation probe",
        "BETTER_AUTH_URL": "https://cfas-probe-418-20261017-dev.broadvisionx.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cfas-probe-418-20261017-dev",
          "migrations_dir": "migrations",
          "database_id": "ae5784cc-b0db-4acc-991f-c43895ddb04a"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "cfas-probe-418-20261017-dev"
        }
      ],
      "workflows": [
        {
          "binding": "BOOTSTRAP_WORKFLOW",
          "name": "cfas-probe-418-20261017-dev-bootstrap",
          "class_name": "BootstrapProbeWorkflow"
        },
        {
          "binding": "RUN_WORKFLOW",
          "name": "cfas-probe-418-20261017-dev-recovery",
          "class_name": "RecoveryProbeWorkflow"
        },
        {
          "binding": "MODEL_WORKFLOW",
          "name": "cfas-probe-418-20261017-dev-model",
          "class_name": "ModelProbeWorkflow"
        }
      ],
      "triggers": {
        "crons": [
          "* * * * *"
        ]
      },
      "ai": {
        "binding": "AI"
      }
    },
    "prod": {
      "name": "cfas-probe-418-20261017-prod",
      "vars": {
        "PROBE_ENV": "prod",
        "PROBE_TITLE": "Validation probe",
        "BETTER_AUTH_URL": "https://cfas-probe-418-20261017-prod.broadvisionx.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cfas-probe-418-20261017-prod",
          "migrations_dir": "migrations",
          "database_id": "311e79f7-6bb6-49f2-8cee-7e19b72a29a8"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "cfas-probe-418-20261017-prod"
        }
      ],
      "workflows": [
        {
          "binding": "BOOTSTRAP_WORKFLOW",
          "name": "cfas-probe-418-20261017-prod-bootstrap",
          "class_name": "BootstrapProbeWorkflow"
        },
        {
          "binding": "RUN_WORKFLOW",
          "name": "cfas-probe-418-20261017-prod-recovery",
          "class_name": "RecoveryProbeWorkflow"
        },
        {
          "binding": "MODEL_WORKFLOW",
          "name": "cfas-probe-418-20261017-prod-model",
          "class_name": "ModelProbeWorkflow"
        }
      ],
      "triggers": {
        "crons": [
          "* * * * *"
        ]
      },
      "ai": {
        "binding": "AI"
      }
    }
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "assets": {
    "directory": "../budget-protocol/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "ai": {
    "binding": "AI"
  }
}
